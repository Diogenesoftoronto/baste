{"parentUuid":"7394fe78-3bd2-4cee-90e6-130a74b13228","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/diogenes/Projects/apps/baste/scripts/cartesia.mjs","snippet":"1\t/**\n2\t * English narration through Cartesia Sonic, shared by the tour and Studio guide\n3\t * narration scripts. The key comes from CARTESIA_API_KEY, or from Skate with\n4\t * --skate; it is only held in the process and never written to an artifact.\n5\t */\n6\timport { execFileSync } from 'node:child_process';\n7\t\n8\texport const CARTESIA_MODEL = 'sonic-3.6';\n9\t/** Theo: \"steady, enunciating, confident young male for narrations.\" */\n10\texport const NARRATOR = { id: '79f8b5fb-2cc8-479a-80df-29f7a7cf1a3e', name: 'Theo' };\n11\t\n12\texport function cartesiaKey() {\n13\t  const key = process.env.CARTESIA_API_KEY || (process.argv.includes('--skate')\n14\t    ? execFileSync('rtk', ['proxy', 'skate', 'get', 'cartesia_api_key@secrets'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()\n15\t    : '');\n16\t  if (!key) throw new Error('Set CARTESIA_API_KEY or use --skate.');\n17\t  return key;\n18\t}"},"type":"attachment","uuid":"6464bff5-a58c-4a1c-a68d-377da4a24db1","timestamp":"2026-10-14T03:42:09.748Z","rendered":[{"content":"<system-reminder>\nNote: /home/diogenes/Projects/apps/baste/scripts/cartesia.mjs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\t/**\n2\t * English narration through Cartesia Sonic, shared by the tour and Studio guide\n3\t * narration scripts. The key comes from CARTESIA_API_KEY, or from Skate with\n4\t * --skate; it is only held in the process and never written to an artifact.\n5\t */\n6\timport { execFileSync } from 'node:child_process';\n7\t\n8\texport const CARTESIA_MODEL = 'sonic-3.6';\n9\t/** Theo: \"steady, enunciating, confident young male for narrations.\" */\n10\texport const NARRATOR = { id: '79f8b5fb-2cc8-479a-80df-29f7a7cf1a3e', name: 'Theo' };\n11\t\n12\texport function cartesiaKey() {\n13\t  const key = process.env.CARTESIA_API_KEY || (process.argv.includes('--skate')\n14\t    ? execFileSync('rtk', ['proxy', 'skate', 'get', 'cartesia_api_key@secrets'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()\n15\t    : '');\n16\t  if (!key) throw new Error('Set CARTESIA_API_KEY or use --skate.');\n17\t  return key;\n18\t}\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
