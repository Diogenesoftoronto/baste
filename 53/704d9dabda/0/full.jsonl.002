oggle}>\n48\t      <span aria-hidden=\"true\">{playing.value\n49\t        ? <svg width=\"10\" height=\"12\" viewBox=\"0 0 10 12\"><path d=\"M1.5 1 V11 M8.5 1 V11\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" /></svg>\n50\t        : <svg width=\"10\" height=\"12\" viewBox=\"0 0 14 16\"><path d=\"M1.5 1.6 L12.6 8 L1.5 14.4 Z\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" /></svg>}</span>\n51\t      {playing.value ? 'Pause' : french ? 'Lire' : 'Play'}\n52\t    </button>\n53\t  </div>;\n54\t});\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
