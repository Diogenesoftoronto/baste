 size:70%","+00:00:12.753 --> 00:00:14.213 position:60% align:center size:70%"," the music they work to,"," "," 8","-00:00:13.813 --> 00:00:15.713 position:60% align:center size:70%","+00:00:14.233 --> 00:00:16.313 position:60% align:center size:70%"," the rooms they feel at home in,"," "," 9","-00:00:15.733 --> 00:00:18.543 position:60% align:center size:70%","+00:00:16.333 --> 00:00:19.143 position:60% align:center size:70%"," and the things they can’t stand in an app."," "," 10","-00:00:19.747 --> 00:00:21.547 position:60% align:center size:70%","+00:00:19.746 --> 00:00:21.386 position:60% align:center size:70%"," Then it fits an interface to them."," "," 11","-00:00:21.567 --> 00:00:23.247 position:60% align:center size:70%","+00:00:21.406 --> 00:00:23.256 position:60% align:center size:70%"," Same screen, three people."," "," 12","-00:00:23.267 --> 00:00:24.167 position:60% align:center size:70%","+00:00:23.506 --> 00:00:24.926 position:60% align:center size:70%"," The layout, the type,"," "," 13","-00:00:24.187 --> 00:00:26.377 position:60% align:center size:70%","+00:00:24.946 --> 00:00:27.396 position:60% align:center size:70%"," the colour and the motion all change."," "," 14","-00:00:27.847 --> 00:00:28.827 position:60% align:center size:70%","+00:00:27.846 --> 00:00:28.746 position:60% align:center size:70%"," To find a direction,"," "," 15","-00:00:28.847 --> 00:00:31.767 position:60% align:center size:70%","+00:00:28.766 --> 00:00:31.326 position:60% align:center size:70%"," Baste tries dozens of loose versions,"," "," 16","-00:00:31.787 --> 00:00:34.187 position:60% align:center size:70%","+00:00:31.346 --> 00:00:34.466 position:60% align:center size:70%"," warm and cool, sparse and dense,"," "," 17","-00:00:34.207 --> 00:00:36.357 position:60% align:center size:70%","+00:00:34.486 --> 00:00:37.136 position:60% align:center size:70%"," and a vision judge looks at every one."," "," 18","-00:00:37.780 --> 00:00:39.380 position:60% align:center size:70%","+00:00:37.779 --> 00:00:39.479 position:60% align:center size:70%"," It keeps the best in each region,"," "," 19","-00:00:39.400 --> 00:00:40.710 position:60% align:center size:70%","+00:00:39.499 --> 00:00:40.539 position:60% align:center size:70%"," not one winner."," "," 20","-00:00:40.900 --> 00:00:42.520 position:60% align:center size:70%","+00:00:40.559 --> 00:00:42.919 position:60% align:center size:70%"," So you see the real range of options"," "," 21","-00:00:42.540 --> 00:00:44.170 position:60% align:center size:70%","+00:00:42.939 --> 00:00:44.549 position:60% align:center size:70%"," before anything is final."," "," 22","-00:00:45.513 --> 00:00:47.373 position:60% align:center size:70%","+00:00:45.512 --> 00:00:47.572 position:60% align:center size:70%"," What comes out is ready to use:"," "," 23","-00:00:47.393 --> 00:00:50.293 position:60% align:center size:70%","+00:00:47.592 --> 00:00:50.732 position:60% align:center size:70%"," images, vector icons, ambient loops,"," "," 24","-00:00:50.313 --> 00:00:52.513 position:60% align:center size:70%","+00:00:50.752 --> 00:00:53.212 position:60% align:center size:70%"," and design tokens for CSS,"," "," 25","-00:00:52.533 --> 00:00:54.083 position:60% align:center size:70%","+00:00:53.232 --> 00:00:54.882 position:60% align:center size:70%"," Tailwind or Panda."," "," 26","-00:00:55.413 --> 00:00:57.293 position:60% align:center size:70%","+00:00:55.412 --> 00:00:57.242 position:60% align:center size:70%"," And you can ask the persona why."," "," 27","-00:00:57.313 --> 00:00:59.093 position:60% align:center size:70%","+00:00:57.492 --> 00:00:59.512 position:60% align:center size:70%"," They’ll tell you, in their own words,"," "," 28","-00:00:59.113 --> 00:01:00.093 position:60% align:center size:70%","+00:00:59.532 --> 00:01:00.512 position:60% align:center size:70%"," what they love"," "," 29","-00:01:00.113 --> 00:01:03.063 position:60% align:center size:70%","+00:01:00.532 --> 00:01:03.562 position:60% align:center size:70%"," and what would make a design feel like theirs."," "," 30","-00:01:04.380 --> 00:01:05.460 position:60% align:center size:70%","+00:01:04.379 --> 00:01:05.339 position:60% align:center size:70%"," Bring your own people."," "," 31","-00:01:05.480 --> 00:01:06.940 position:60% align:center size:70%","+00:01:05.359 --> 00:01:07.019 position:60% align:center size:70%"," Measure them in the Studio,"," "," 32","-00:01:06.960 --> 00:01:08.550 position:60% align:center size:70%","+00:01:07.039 --> 00:01:09.049 position:60% align:center size:70%"," and cut something that fits."]}]},{"filePath":"/home/diogenes/Projects/apps/baste/site/public/media/tour/captions-fr.vtt","hunks":[{"oldStart":1,"oldLines":129,"newStart":1,"newLines":129,"lines":[" WEBVTT"," "," 1","-00:00:00.480 --> 00:00:01.840 position:60% align:center size:70%","+00:00:00.480 --> 00:00:02.000 position:60% align:center size:70%"," La plupart des interfaces sont taillées pour"," "," 2","-00:00:01.860 --> 00:00:04.720 position:60% align:center size:70%","+00:00:02.020 --> 00:00:05.500 position:60% align:center size:70%"," « les 25 à 34 ans »."," "," 3","-00:00:04.740 --> 00:00:06.700 position:60% align:center size:70%","+00:00:05.520 --> 00:00:07.560 position:60% align:center size:70%"," Personne dans cette tranche n’a de goût."," "," 4","-00:00:06.720 --> 00:00:07.890 position:60% align:center size:70%","+00:00:07.580 --> 00:00:08.710 position:60% align:center size:70%"," Une personne, si."," "," 5","-00:00:09.213 --> 00:00:10.793 position:60% align:center size:70%","+00:00:09.213 --> 00:00:10.833 position:60% align:center size:70%"," Baste part d’une seule personne :"," "," 6","-00:00:10.813 --> 00:00:12.373 position:60% align:center size:70%","+00:00:10.853 --> 00:00:12.733 position:60% align:center size:70%"," les films qu’elle revoit,"," "," 7","-00:00:12.393 --> 00:00:13.793 position:60% align:center size:70%","+00:00:12.753 --> 00:00:14.213 position:60% align:center size:70%"," la musique sur laquelle elle travaille,"," "," 8","-00:00:13.813 --> 00:00:15.713 position:60% align:center size:70%","+00:00:14.233 --> 00:00:16.313 position:60% align:center size:70%"," les lieux où elle se sent chez elle,"," "," 9","-00:00:15.733 --> 00:00:18.543 position:60% align:center size:70%","+00:00:16.333 --> 00:00:19.143 position:60% align:center size:70%"," et ce qu’elle ne supporte pas dans une appli."," "," 10","-00:00:19.747 --> 00:00:21.547 position:60% align:center size:70%","+00:00:19.746 --> 00:00:21.386 position:60% align:center size:70%"," Puis il lui ajuste une interface."," "," 11","-00:00:21.567 --> 00:00:23.247 position:60% align:center size:70%","+00:00:21.406 --> 00:00:23.256 position:60% align:center size:70%"," Même écran, trois personnes."," "," 12","-00:00:23.267 --> 00:00:24.167 position:60% align:center size:70%","+00:00:23.506 --> 00:00:24.926 position:60% align:center size:70%"," La mise en page, la typographie,"," "," 13","-00:00:24.187 --> 00:00:26.377 position:60% align:center size:70%","+00:00:24.946 --> 00:00:27.396 position:60% align:center size:70%"," la couleur et le mouvement changent tous."," "," 14","-00:00:27.847 --> 00:00:28.827 position:60% align:center size:70%","+00:00:27.846 --> 00:00:28.746 position:60% align:center size:70%"," Pour trouver une direction,"," "," 15","-00:00:28.847 --> 00:00:31.767 position:60% align:center size:70%","+00:00:28.766 --> 00:00:31.326 position:60% align:center size:70%"," Baste essaie des dizaines de versions à grands traits,"," "," 16","-00:00:31.787 --> 00:00:34.187 position:60% align:center size:70%","+00:00:31.346 --> 00:00:34.466 position:60% align:center size:70%"," chaudes et froides, aérées et denses,"," "," 17","-00:00:34.207 --> 00:00:36.357 position:60% align:center size:70%","+00:00:34.486 --> 00:00:37.136 position:60% align:center size:70%"," et un juge visuel les examine toutes."," "," 18","-00:00:37.780 --> 00:00:39.380 position:60% align:center size:70%","+00:00:37.779 --> 00:00:39.479 position:60% align:center size:70%"," Il garde la meilleure de chaque région,"," "," 19","-00:00:39.400 --> 00:00:40.710 position:60% align:center size:70%","+00:00:39.499 --> 00:00:40.539 position:60% align:center size:70%"," pas un seul gagnant."," "," 20","-00:00:40.900 --> 00:00:42.520 position:60% align:center size:70%","+00:00:40.559 --> 00:00:42.919 position:60% align:center size:70%"," Vous voyez ainsi le véritable éventail des options"," "," 21","-00:00:42.540 --> 00:00:44.170 position:60% align:center size:70%","+00:00:42.939 --> 00:00:44.549 position:60% align:center size:70%"," avant que rien ne soit arrêté."," "," 22","-00:00:45.513 --> 00:00:47.373 position:60% align:center size:70%","+00:00:45.512 --> 00:00:47.572 position:60% align:center size:70%"," Ce qui en sort est prêt à l’emploi :"," "," 23","-00:00:47.393 --> 00:00:50.293 position:60% align:center size:70%","+00:00:47.592 --> 00:00:50.732 position:60% align:center size:70%"," images, icônes vectorielles, boucles d’ambiance,"," "," 24","-00:00:50.313 --> 00:00:52.513 position:60% align:center size:70%","+00:00:50.752 --> 00:00:53.212 position:60% align:center size:70%"," et jetons de design pour CSS,"," "," 25","-00:00:52.533 --> 00:00:54.083 position:60% align:center size:70%","+00:00:53.232 --> 00:00:54.882 position:60% align:center size:70%"," Tailwind ou Panda."," "," 26","-00:00:55.413 --> 00:00:57.293 position:60% align:center size:70%","+00:00:55.412 --> 00:00:57.242 position:60% align:center size:70%"," Et vous pouvez demander au persona pourquoi."," "," 27","-00:00:57.313 --> 00:00:59.093 position:60% align:center size:70%","+00:00:57.492 --> 00:00:59.512 position:60% align:center size:70%"," Il vous dira, avec ses propres mots,"," "," 28","-00:00:59.113 --> 00:01:00.093 position:60% align:center size:70%","+00:00:59.532 --> 00:01:00.512 position:60% align:center size:70%"," ce qu’il aime"," "," 29","-00:01:00.113 --> 00:01:03.063 position:60% align:center size:70%","+00: