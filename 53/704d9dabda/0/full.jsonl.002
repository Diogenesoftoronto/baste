00:39.419 --> 00:00:40.479 position:60% align:center size:70%"," pas un seul gagnant."," "," 20","-00:00:40.559 --> 00:00:42.919 position:60% align:center size:70%","+00:00:40.499 --> 00:00:42.719 position:60% align:center size:70%"," Vous voyez ainsi le véritable éventail des options"," "," 21","-00:00:42.939 --> 00:00:44.549 position:60% align:center size:70%","+00:00:42.739 --> 00:00:44.209 position:60% align:center size:70%"," avant que rien ne soit arrêté."," "," 22","-00:00:45.512 --> 00:00:47.572 position:60% align:center size:70%","+00:00:45.512 --> 00:00:47.392 position:60% align:center size:70%"," Ce qui en sort est prêt à l’emploi :"," "," 23","-00:00:47.592 --> 00:00:50.732 position:60% align:center size:70%","+00:00:47.412 --> 00:00:50.472 position:60% align:center size:70%"," images, icônes vectorielles, boucles d’ambiance,"," "," 24","-00:00:50.752 --> 00:00:53.212 position:60% align:center size:70%","+00:00:50.492 --> 00:00:52.772 position:60% align:center size:70%"," et jetons de design pour CSS,"," "," 25","-00:00:53.232 --> 00:00:54.882 position:60% align:center size:70%","+00:00:52.792 --> 00:00:54.422 position:60% align:center size:70%"," Tailwind ou Panda."," "," 26","-00:00:55.412 --> 00:00:57.242 position:60% align:center size:70%","+00:00:55.412 --> 00:00:57.262 position:60% align:center size:70%"," Et vous pouvez demander au persona pourquoi."," "," 27","-00:00:57.492 --> 00:00:59.512 position:60% align:center size:70%","+00:00:57.332 --> 00:00:59.112 position:60% align:center size:70%"," Il vous dira, avec ses propres mots,"," "," 28","-00:00:59.532 --> 00:01:00.512 position:60% align:center size:70%","+00:00:59.132 --> 00:00:59.992 position:60% align:center size:70%"," ce qu’il aime"," "," 29","-00:01:00.532 --> 00:01:03.562 position:60% align:center size:70%","+00:01:00.012 --> 00:01:02.762 position:60% align:center size:70%"," et ce qui ferait qu’un design lui ressemble."," "," 30","-00:01:04.379 --> 00:01:05.339 position:60% align:cent