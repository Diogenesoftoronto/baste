{"parentUuid":"e21854fd-0173-40b0-aded-61797906c1bd","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/diogenes/Projects/apps/baste/site/src/components/sections/tour.tsx","snippet":""},"type":"attachment","uuid":"a3dff955-81e0-4ed6-b0d7-4b80948010d9","timestamp":"2026-10-14T03:42:09.748Z","rendered":[{"content":"<system-reminder>\nNote: /home/diogenes/Projects/apps/baste/site/src/components/sections/tour.tsx changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. The changes are not shown here; use Read if you need the current content.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
{"parentUuid":"a3dff955-81e0-4ed6-b0d7-4b80948010d9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/diogenes/Projects/apps/baste/videos/baste-tour/publish.mjs","snippet":"3\t * Publishes the rendered tour to the site: site/public/media/tour/.\n4\t *\n5\t *   node videos/baste-tour/publish.mjs\n6\t *\n7\t * Reads renders/baste-tour.mp4 (`npm run render` here), captions.vtt and\n8\t * captions.fr.vtt (build.mjs) and the recorded takes in footage/cfr/. Writes a\n9\t * web encode of the tour with its poster and captions, and the silent chapter\n10\t * clips the Studio guide plays, each with a still. Takes are cut after 3.6 s,\n11\t * when the dev overlay has left the frame. site/src/lib/tour.json gives the site\n12\t * each chapter's start and its narration in English and French, so the chapter\n13\t * list and transcripts follow the cut.\n14\t */\n15\timport { execFileSync } from \"node:child_process\";\n16\timport { copyFileSync, existsSync, mkdirSync, readFileSync, statSync, writeFileSync } from \"node:fs\";\n17\timport { dirname, join, resolve } from \"node:path\";\n18\timport { fileURLToPath } from \"node:url\";\n19\t\n20\tconst here = dirname(fileURLToPath(import.meta.url));\n21\tconst out = resolve(here, \"../../site/public/media/tour\");\n22\tmkdirSync(join(out, \"clips\"), { recursive: true });\n23\t\n24\tconst ffmpeg = (...args) => execFileSync(\"ffmpeg\", [\"-v\", \"error\", \"-y\", ...args], { stdio: \"inherit\" });\n25\tconst report = (file) => console.log(`${file.replace(`${out}/`, \"media/tour/\")}  ${(statSync(file).size / 1e6).toFixed(1)} MB`);\n26\t\n27\t// Refuse a render that is still being written: the log's final line is \"exit 0\" only once it is done.\n28\tconst log = join(here, \"renders/render.log\");\n29\tif (existsSync(log) && !/exit 0\\s*$/.test(readFileSync(log, \"utf8\"))) throw new Error(\"renders/render.log does not end in \\\"exit 0\\\"; the render is unfinished or failed.\");\n30\t// The tour: 1080p H.264 with the moov atom up front, so it starts before it has loaded.\n31\tconst tour = join(out, \"baste-tour.mp4\");\n32\tffmpeg(\"-i\", join(here, \"renders/baste-tour.mp4\"), \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"22\", \"-tune\", \"stillimage\",\n33\t  \"-pix_fmt\", \"yuv420p\", \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-movflags\", \"+faststart\", tour);\n34\treport(tour);\n35\t// \"Eight kept, from cool to warm\": the frame that says the most about what Baste does.\n36\tffmpeg(\"-ss\", \"43\", \"-i\", join(here, \"renders/baste-tour.mp4\"), \"-frames:v\", \"1\", \"-c:v\", \"libwebp\", \"-quality\", \"86\", join(out, \"poster.webp\"));\n37\treport(join(out, \"poster.webp\"));\n...\n35\t\n36\t// Chapter clips for the Studio guide: source seconds in each take, and the frame used as the still.\n37\tconst CLIPS = [\n38\t  { id: \"generate\", take: \"archive\", from: 6.0, to: 34.9, still: 34.4 },\n39\t  { id: \"tokens\", take: \"tokens\", from: 3.7, to: 12.1, still: 5.2 },\n40\t  { id: \"conversation\", take: \"talk\", from: 3.7, to: 16.9, still: 16.4 },\n41\t  { id: \"new-persona\", take: \"yours\", from: 3.7, to: 16.4, still: 15.9 },\n42\t];\n43\t// The archive take's replay shows the raw Recraft icons; the site uses refined ones, so they are laid\n44\t// over the two icon tiles. ICON_TILES is where the tiles' tops sit (source px) as the page scrolls into\n45\t// the cut, measured from the take; from 29.67 s they are still.\n46\tconst ICON_TILES = [[29.4, 827], [29.433, 708], [29.467, 661], [29.533, 616], [29.567, 596], [29.6, 582], [29.633, 571], [29.667, 567]];\n47\tconst PATCHES = [[\"patch-mycelium.png\", 734], [\"patch-herbarium.png\", 896]];\n48\tconst patched = (c, scale) => {\n49\t  if (c.take !== \"archive\") return { inputs: [], graph: `[0:v]${scale}[v]` };\n50\t  // Clip time t is source time minus c.from; each tile top is held until the next measurement.\n51\t  let y = \"3000\";\n52\t  for (const [at, top] of ICON_TILES) y = `if(gte(t,${(at - c.from - 0.015).toFixed(3)}),${top + 3},${y})`;\n53\t  const inputs = PATCHES.flatMap(([png]) => [\"-loop\", \"1\", \"-i\", join(here, \"assets/patches\", png)]);\n54\t  const graph = `[0:v][1:v]overlay=x=${PATCHES[0][1]}:y='${y}':shortest=1[a];[a][2:v]overlay=x=${PATCHES[1][1]}:y='${y}':shortest=1,${scale}[v]`;\n55\t  return { inputs, graph };\n56\t};\n57\tfor (const c of CLIPS) {\n58\t  if (c.from < 3.6) throw new Error(`${c.id} starts inside the dev overlay`);\n59\t  const src = join(here, \"footage/cfr\", `${c.take}.mp4`);\n60\t  const file = join(out, \"clips\", `${c.id}.mp4`);\n61\t  const scale = \"scale=1280:800:flags=lanczos\";\n62\t  const clip = patched(c, scale);\n63\t  ffmpeg(\"-ss\", String(c.from), \"-to\", String(c.to), \"-i\", src, ...clip.inputs, \"-filter_complex\", clip.graph, \"-map\", \"[v]\", \"-an\", \"-c:v\", \"libx264\",\n64\t    \"-preset\", \"slow\", \"-crf\", \"24\", \"-tune\", \"stillimage\", \"-pix_fmt\", \"yuv420p\", \"-movflags\", \"+faststart\", file);\n65\t  const still = patched({ ...c, from: c.still }, scale);\n66\t  ffmpeg(\"-ss\", String(c.still), \"-i\", src, ...still.inputs, \"-filter_complex\", still.graph, \"-map\", \"[v]\", \"-frames:v\", \"1\", \"-c:v\", \"libwebp\", \"-quality\", \"84\",\n67\t    join(out, \"clips\", `${c.id}.webp`));\n68\t  report(file);\n69\t}\n70\t\n71\t// Chapters and transcript for the site. French lines are the subtitles that fall inside each scene.\n72\tconst TITLES = {\n73\t  why: [\"A person\", \"Une personne\"], measure: [\"Measure\", \"Mesurer\"], fitting: [\"Fitting room\", \"Cabine d’essayage\"],\n74\t  baste: [\"Baste\", \"Bâtir\"], fit: [\"Fit\", \"Ajuster\"], cut: [\"Cut\", \"Couper\"], talk: [\"Talk\", \"Parler\"], yours: [\"Yours\", \"À vous\"],\n75\t};\n76\tconst cues = (file) => readFileSync(join(here, file), \"utf8\").trim().split(\"\\n\\n\").slice(1).map((block) => {\n77\t  const [, time, ...text] = block.split(\"\\n\");\n78\t  const [h, m, sec] = time.split(\" --> \")[0].split(\":\");\n79\t  return { start: +h * 3600 + +m * 60 + +sec, text: text.join(\" \") };\n80\t});\n81\tconst french = cues(\"captions.fr.vtt\");\n82\tconst { scenes } = JSON.parse(readFileSync(join(here, \"narration/timing.json\"), \"utf8\"));\n83\tconst manifest = {\n84\t  src: \"/media/tour/baste-tour.mp4\",\n85\t  poster: \"/media/tour/poster.webp\",\n86\t  captions: { en: \"/media/tour/captions-en.vtt\", fr: \"/media/tour/captions-fr.vtt\" },\n87\t  duration: +execFileSync(\"ffprobe\", [\"-v\", \"error\", \"-show_entries\", \"format=duration\", \"-of\", \"csv=p=0\", tour], { encoding: \"utf8\" }).trim(),\n88\t  recorded: \"2026-10-10\",\n89\t  chapters: scenes.map((s, i) => {\n90\t    const end = scenes[i + 1]?.start ?? Infinity;\n91\t    return {\n92\t      id: s.id, start: +s.start.toFixed(2), title: TITLES[s.id][0], titleFr: TITLES[s.id][1], text: s.text,\n93\t      textFr: french.filter((c) => c.start >= s.start && c.start < end).map((c) => c.text).join(\" \"),\n94\t    };\n95\t  }),\n96\t};\n97\twriteFileSync(resolve(here, \"../../site/src/lib/tour.json\"), JSON.stringify(manifest, null, 2) + \"\\n\");\n98\tconsole.log(\"site/src/lib/tour.json\");"},"type":"attachment","uuid":"ec6c25b5-9586-4553-bf7f-30f26615821e","timestamp":"2026-10-14T03:42:09.748Z","rendered":[{"content":"<system-reminder>\nNote: /home/diogenes/Projects/apps/baste/videos/baste-tour/publish.mjs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n3\t * Publishes the rendered tour to the site: site/public/media/tour/.\n4\t *\n5\t *   node videos/baste-tour/publish.mjs\n6\t *\n7\t * Reads renders/baste-tour.mp4 (`npm run render` here), captions.vtt and\n8\t * captions.fr.vtt (build.mjs) and the recorded takes in footage/cfr/. Writes a\n9\t * web encode of the tour 