 voice lines in assets/voice/.","  *","  * Inputs"]},{"oldStart":742,"oldLines":5,"newStart":743,"newLines":11,"lines":[" "," levelVoice();"," writeFileSync(join(here, \"index.html\"), html);","-writeFileSync(join(here, \"captions.vtt\"), vtt());","+const captions = vtt();","+writeFileSync(join(here, \"captions.vtt\"), captions);","+// French subtitles reuse the English timings; narration/captions.fr.json holds one line per cue.","+const french = JSON.parse(readFileSync(join(here, \"narration/captions.fr.json\"), \"utf8\")).cues;","+const blocks = captions.trim().split(\"\\n\\n\").slice(1);","+if (french.length !== blocks.length) throw new Error(`captions.fr.json has ${french.length} lines for ${blocks.length} cues`);","+writeFileSync(join(here, \"captions.fr.vtt\"), [\"WEBVTT\", \"\", ...blocks.map((b, i) => `${b.split(\"\\n\").slice(0, 2).join(\"\\n\")}\\n${french[i]}\\n`)].join(\"\\n\"));"," console.log(SEGMENTS.map((s) => `${s.id.padEnd(8)} ${String(s.start).padStart(6)}–${String(s.end).padEnd(6)} src ${s.from}→${s.until} ×${s.rate}`).join(\"\\n\"));"]}]},{"filePath":"/home/diogenes/Projects/apps/baste/videos/baste-tour/captions.fr.vtt","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":129,"lines":["+WEBVTT","+","+1","+00:00:00.480 --> 00:00:01.840","+La plupart des interfaces sont taillées pour","+","+2","+00:00:01.860 --> 00:00:04.720","+« les 25 à 34 ans ».","+","+3","+00:00:04.740 --> 00:00:06.700","+Personne dans cette tranche n’a de goût.","+","+4","+00:00:06.720 --> 00:00:07.890","+Une personne, si.","+","+5","+00:00:09.213 --> 00:00:10.793","+Baste part d’une seule personne :","+","+6","+00:00:10.813 --> 00:00:12.373","+les films qu’elle revoit,","+","+7","+00:00:12.393 --> 00:00:13.793","+la musique sur laquelle elle travaille,","+","+8","+00:00:13.813 --> 00:00:15.713","+les lieux où elle se sent chez elle,","+","+9","+00:00:15.733 --> 00:00:18.543","+et ce qu’elle ne supporte pas dans une appli.","+","+10","+00:00:19.747 --> 00:00:21.547","+Puis il lui ajuste une interface.","+","+11","+00:00:21.567 --> 00:00:23.247","+Même écran, trois personnes.","+","+12","+00:00:23.267 --> 00:00:24.167","+La mise en page, la typographie,","+","+13","+00:00:24.187 --> 00:00:26.377","+la couleur et le mouvement changent tous.","+","+14","+00:00:27.847 --> 00:00:28.827","+Pour trouver une direction,","+","+15","+00:00:28.847 --> 00:00:31.767","+Baste essaie des dizaines de versions à grands traits,","+","+16","+00:00:31.787 --> 00:00:34.187","+chaudes et froides, aérées et denses,","+","+17","+00:00:34.207 --> 00:00:36.357","+et un juge visuel les examine toutes.","+","+18","+00:00:37.780 --> 00:00:39.380","+Il garde la meilleure de chaque région,","+","+19","+00:00:39.400 --> 00:00:40.710","+pas un seul gagnant.","+","+20","+00:00:40.900 --> 00:00:42.520","+Vous voyez ainsi le véritable éventail des options","+","+21","+00:00:42.540 --> 00:00:44.170","+avant que rien ne soit arrêté.","+","+22","+00:00:45.513 --> 00:00:47.373","+Ce qui en sort est prêt à l’emploi :","+","+23","+00:00:47.393 --> 00:00:50.293","+images, icônes vectorielles, boucles d’ambiance,","+","+24","+00:00:50.313 --> 00:00:52.513","+et jetons de design pour CSS,","+","+25","+00:00:52.533 --> 00:00:54.083","+Tailwind ou Panda.","+","+26","+00:00:55.413 --> 00:00:57.293","+Et vous pouvez demander au persona pourquoi.","+","+27","+00:00:57.313 --> 00:00:59.093","+Il vous dira, avec ses propres mots,","+","+28","+00:00:59.113 --> 00:01:00.093","+ce qu’il aime","+","+29","+00:01:00.113 --> 00:01:03.063","+et ce qui ferait qu’un design lui ressemble.","+","+30","+00:01:04.380 --> 00:01:05.460","+Amenez vos propres personnes.","+","+31","+00:01:05.480 --> 00:01:06.940","+Mesurez-les dans le Studio,","+","+32","+00:01:06.960 --> 00:01:08.550","+et taillez quelque chose qui leur va."]}],"created":true}],"moreFiles":0,"changedFiles":["/home/diogenes/Projects/apps/baste/videos/baste-tour/narration/captions.fr.json","/home/diogenes/Projects/apps/baste/videos/