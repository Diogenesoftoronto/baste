{"parentUuid":"40ac0310-566c-4e71-8082-f775f8737d2f","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/diogenes/Projects/apps/baste/videos/baste-tour/publish.mjs","snippet":"3\t * Publishes the rendered tour to the site: site/public/media/tour/.\n4\t *\n5\t *   node videos/baste-tour/publish.mjs\n6\t *\n7\t * Reads renders/baste-tour.mp4 (`npm run render` here), captions.vtt and\n8\t * captions.fr.vtt (build.mjs) and the recorded takes in footage/cfr/. Writes a\n9\t * web encode of the tour with its poster and captions, and the silent chapter\n10\t * clips the Studio guide plays, each with a still. Takes are cut after 3.6 s,\n11\t * when the dev overlay has left the frame. site/src/lib/tour.json gives the site\n12\t * each chapter's start and its narration in English and French, so the chapter\n13\t * list and transcripts follow the cut.\n14\t */\n15\timport { execFileSync } from \"node:child_process\";\n16\timport { copyFileSync, mkdirSync, readFileSync, statSync, writeFileSync } from \"node:fs\";\n17\timport { dirname, join, resolve } from \"node:path\";\n18\timport { fileURLToPath } from \"node:url\";\n19\t\n20\tconst here = dirname(fileURLToPath(import.meta.url));\n21\tconst out = resolve(here, \"../../site/public/media/tour\");\n22\tmkdirSync(join(out, \"clips\"), { recursive: true });\n23\t\n24\tconst ffmpeg = (...args) => execFileSync(\"ffmpeg\", [\"-v\", \"error\", \"-y\", ...args], { stdio: \"inherit\" });\n...\n45\t  const src = join(here, \"footage/cfr\", `${c.take}.mp4`);\n46\t  const file = join(out, \"clips\", `${c.id}.mp4`);\n47\t  ffmpeg(\"-ss\", String(c.from), \"-to\", String(c.to), \"-i\", src, \"-an\", \"-vf\", \"scale=1280:800:flags=lanczos\", \"-c:v\", \"libx264\",\n48\t    \"-preset\", \"slow\", \"-crf\", \"24\", \"-tune\", \"stillimage\", \"-pix_fmt\", \"yuv420p\", \"-movflags\", \"+faststart\", file);\n49\t  ffmpeg(\"-ss\", String(c.still), \"-i\", src, \"-frames:v\", \"1\", \"-vf\", \"scale=1280:800:flags=lanczos\", \"-c:v\", \"libwebp\", \"-quality\", \"84\",\n50\t    join(out, \"clips\", `${c.id}.webp`));\n51\t  report(file);\n52\t}\n53\t\n54\t// Chapters and transcript for the site. French lines are the subtitles that fall inside each scene.\n55\tconst TITLES = {\n56\t  why: [\"A person\", \"Une personne\"], measure: [\"Measure\", \"Mesurer\"], fitting: [\"Fitting room\", \"Cabine d’essayage\"],\n57\t  baste: [\"Baste\", \"Bâtir\"], fit: [\"Fit\", \"Ajuster\"], cut: [\"Cut\", \"Couper\"], talk: [\"Talk\", \"Parler\"], yours: [\"Yours\", \"À vous\"],\n58\t};\n59\tconst cues = (file) => readFileSync(join(here, file), \"utf8\").trim().split(\"\\n\\n\").slice(1).map((block) => {\n60\t  const [, time, ...text] = block.split(\"\\n\");\n61\t  const [h, m, sec] = time.split(\" --> \")[0].split(\":\");\n62\t  return { start: +h * 3600 + +m * 60 + +sec, text: text.join(\" \") };\n63\t});\n64\tconst french = cues(\"captions.fr.vtt\");\n65\tconst { scenes } = JSON.parse(readFileSync(join(here, \"narration/timing.json\"), \"utf8\"));\n66\tconst manifest = {\n67\t  src: \"/media/tour/baste-tour.mp4\",\n68\t  poster: \"/media/tour/poster.webp\",\n69\t  captions: { en: \"/media/tour/captions-en.vtt\", fr: \"/media/tour/captions-fr.vtt\" },\n70\t  duration: +execFileSync(\"ffprobe\", [\"-v\", \"error\", \"-show_entries\", \"format=duration\", \"-of\", \"csv=p=0\", tour], { encoding: \"utf8\" }).trim(),\n71\t  recorded: \"2026-10-10\",\n72\t  chapters: scenes.map((s, i) => {\n73\t    const end = scenes[i + 1]?.start ?? Infinity;\n74\t    return {\n75\t      id: s.id, start: +s.start.toFixed(2), title: TITLES[s.id][0], titleFr: TITLES[s.id][1], text: s.text,\n76\t      textFr: french.filter((c) => c.start >= s.start && c.start < end).map((c) => c.text).join(\" \"),\n77\t    };\n78\t  }),\n79\t};\n80\twriteFileSync(resolve(here, \"../../site/src/lib/tour.json\"), JSON.stringify(manifest, null, 2) + \"\\n\");\n81\tconsole.log(\"site/src/lib/tour.json\");"},"type":"attachment","uuid":"1c8000d7-d3ff-4e76-82a7-79d7c4462620","timestamp":"2026-10-14T02:43:35.403Z","rendered":[{"content":"<system-reminder>\nNote: /home/diogenes/Projects/apps/baste/videos/baste-tour/publish.mjs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n3\t * Publishes the rendered tour to the site: site/public/media/tour/.\n4\t *\n5\t *   node videos/baste-tour/publish.mjs\n6\t *\n7\t * Reads renders/baste-tour.mp4 (`npm run render` here), captions.vtt and\n8\t * captions.fr.vtt (build.mjs) and the recorded takes in footage/cfr/. Writes a\n9\t * web encode of the tour with its poster and captions, and the silent chapter\n10\t * clips the Studio guide plays, each with a still. Takes are cut after 3.6 s,\n11\t * when the dev overlay has left the frame. site/src/lib/tour.json gives the site\n12\t * each chapter's start and its narration in English and French, so the chapter\n13\t * list and transcripts follow the cut.\n14\t */\n15\timport { execFileSync } from \"node:child_process\";\n16\timport { copyFileSync, mkdirSync, readFileSync, statSync, writeFileSync } from \"node:fs\";\n17\timport { dirname, join, resolve } from \"node:path\";\n18\timport { fileURLToPath } from \"node:url\";\n19\t\n20\tconst here = dirname(fileURLToPath(import.meta.url));\n21\tconst out = resolve(here, \"../../site/public/media/tour\");\n22\tmkdirSync(join(out, \"clips\"), { recursive: true });\n23\t\n24\tconst ffmpeg = (...args) => execFileSync(\"ffmpeg\", [\"-v\", \"error\", \"-y\", ...args], { stdio: \"inherit\" });\n...\n45\t  const src = join(here, \"footage/cfr\", `${c.take}.mp4`);\n46\t  const file = join(out, \"clips\", `${c.id}.mp4`);\n47\t  ffmpeg(\"-ss\", String(c.from), \"-to\", String(c.to), \"-i\", src, \"-an\", \"-vf\", \"scale=1280:800:flags=lanczos\", \"-c:v\", \"libx264\",\n48\t    \"-preset\", \"slow\", \"-crf\", \"24\", \"-tune\", \"stillimage\", \"-pix_fmt\", \"yuv420p\", \"-movflags\", \"+faststart\", file);\n49\t  ffmpeg(\"-ss\", String(c.still), \"-i\", src, \"-frames:v\", \"1\", \"-vf\", \"scale=1280:800:flags=lanczos\", \"-c:v\", \"libwebp\", \"-quality\", \"84\",\n50\t    join(out, \"clips\", `${c.id}.webp`));\n51\t  report(file);\n52\t}\n53\t\n54\t// Chapters and transcript for the site. French lines are the subtitles that fall inside each scene.\n55\tconst TITLES = {\n56\t  why: [\"A person\", \"Une personne\"], measure: [\"Measure\", \"Mesurer\"], fitting: [\"Fitting room\", \"Cabine d’essayage\"],\n57\t  baste: [\"Baste\", \"Bâtir\"], fit: [\"Fit\", \"Ajuster\"], cut: [\"Cut\", \"Couper\"], talk: [\"Talk\", \"Parler\"], yours: [\"Yours\", \"À vous\"],\n58\t};\n59\tconst cues = (file) => readFileSync(join(here, file), \"utf8\").trim().split(\"\\n\\n\").slice(1).map((block) => {\n60\t  const [, time, ...text] = block.split(\"\\n\");\n61\t  const [h, m, sec] = time.split(\" --> \")[0].split(\":\");\n62\t  return { start: +h * 3600 + +m * 60 + +sec, text: text.join(\" \") };\n63\t});\n64\tconst french = cues(\"captions.fr.vtt\");\n65\tconst { scenes } = JSON.parse(readFileSync(join(here, \"narration/timing.json\"), \"utf8\"));\n66\tconst manifest = {\n67\t  src: \"/media/tour/baste-tour.mp4\",\n68\t  poster: \"/media/tour/poster.webp\",\n69\t  captions: { en: \"/media/tour/captions-en.vtt\", fr: \"/media/tour/captions-fr.vtt\" },\n70\t  duration: +execFileSync(\"ffprobe\", [\"-v\", \"error\", \"-show_entries\", \"format=duration\", \"-of\", \"csv=p=0\", tour], { encoding: \"utf8\" }).trim(),\n71\t  recorded: \"2026-10-10\",\n72\t  chapters: scenes.map((s, i) => {\n73\t    const end = scenes[i + 1]?.start ?? Infinity;\n74\t    return {\n75\t      id: s.id, start: +s.start.toFixed(2), title: TITLES[s.id][0], titleFr: TITLES[s.id][1], text: s.text,\n76\t      textFr: french.filter((c) => c.start >= s.start && c.start < end).map((c) => c.text).join(\" \"),\n77\t    };\n78\t  }),\n79\t};\n80\twriteFileSync(resolve(here, \"../../site/src/lib/tour.json\"), JSON.stringify(manifest, null, 2) + \"\\n\");\n81\tconsole.log(\"site/src/lib/tour.json\");\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
