pending ? 'thinking' : speech.phase;\n  const presenceLabel = ({ idle: 'Here with you', requesting: 'Waiting for your microphone', listening: `Listening · ${speech.seconds}s`, transcribing: 'Writing down your words', thinking: `${voice.handle} is thinking`, preparing: 'Preparing the voice', speaking: `${voice.handle} is speaking`, paused: 'Voice paused' } as Record<string, string>)[presence];\n\n  return (\n    <div class=\"companion-conversation\" ref={presenceRoot} data-voice-state={presence}>\n      <div role=\"tablist\" aria-label=\"Talk to\" class=\"companion-choices\">\n        {personas.map((p) => {\ncomponents/converse/conversation.tsx:274:                <div key={i} class=\"companion-message msg-in\" data-from={turn.from} data-grouped={grouped}>\nglobal.css:665:.msg-in { animation: message-arrive 200ms var(--ease-thread); }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"a09624cd-536c-4c45-8248-a7a3e2d99876","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste/site/src","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
