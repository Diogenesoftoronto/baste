ns.tsx:46:            <h2 id=\"tok-title\" class={panelTitle}>Design tokens</h2>\nfitting/fitting-room.tsx\nfitting/fitting-room.css\nfitting/fitting-room.tsx:128:              {autoplay && selected && !touched.value && <i class=\"fitting-tab-timer\" aria-hidden=\"true\" />}\nfitting/fitting-room.css:29:.fitting-tab-timer {\nfitting/fitting-room.css:111:  .fitting-garment .garment, .fitting-motion i, .fitting-tab-timer { animation: none; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"4cabde64-0e8d-49b3-8b91-26241fc0dd38","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"/home/diogenes/Projects/apps/baste/site/src/components","sessionId":"69afbb2a-630d-41bd-9b69-0c77564d8af1","version":"2.1.296","gitBranch":"main","slug":"toasty-puzzling-hopcroft"}
