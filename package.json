{
  "name": "baste",
  "version": "0.2.0",
  "description": "Persona-driven UI and asset generation using AI agents",
  "type": "module",
  "bin": {
    "baste": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./persona": {
      "types": "./dist/src/persona/index.d.ts",
      "import": "./dist/src/persona/index.js"
    },
    "./config": {
      "types": "./dist/src/config/baste-config.d.ts",
      "import": "./dist/src/config/baste-config.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/server.d.ts",
      "import": "./dist/src/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "src/gui/public"
  ],
  "scripts": {
    "dev": "flue dev --target node",
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "generate": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "dev:api": "node scripts/runtime.mjs api",
    "dev:site": "node scripts/runtime.mjs site",
    "dev:storybook": "node scripts/runtime.mjs storybook",
    "test:site": "npm --prefix site run test"
  },
  "dependencies": {
    "@flue/sdk": "^0.3.11",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "openai": "^7.27.0",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@flue/cli": "^0.3.11",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
