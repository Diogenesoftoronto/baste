# Baste API Keys
# Copy to .env and fill in your keys

# OpenAI - GPT Image 2.5 generation and fallback OpenAI judge
OPENAI_API_KEY=sk-...
# Optional model for local persona conversations (separate from asset judging).
BASTE_CONVERSATION_MODEL=gpt-4o

# Optional companion speech and microphone transcription. Keep this server-side.
FAL_KEY=
# Cartesia: English narration for the tour and Studio guide videos (scripts only).
CARTESIA_API_KEY=
# Local voice is enabled when FAL_KEY is present. Set false to disable.
# Hosted account mode requires an explicit true and an authenticated session.
# This uses the operator's fal balance, not a Not Organic wallet charge.
BASTE_VOICE_ENABLED=

# QuiverAI - Required for SVG generation
QUIVER_API_KEY=qv-...

# BytePlus ModelArk - Required for Seedance video generation (default)
ARK_API_KEY=

# TypeSafe System One (Jev) - Automatically selected judge when set
TYPESAFE_API_KEY=

# Google - Optional Gemini images / Veo video generation
GOOGLE_API_KEY=AIza...

# Development processes (devenv up starts API + Qwik Studio)
BASTE_API_PORT=3456
BASTE_SITE_PORT=5173
BASTE_STORYBOOK_PORT=6006
BASTE_STORYBOOK_ENABLED=false
BASTE_PUBLIC_ORIGIN=http://localhost:5173

# Not Organic account mode. Requires Baste registration on the provider.
# Provider tokens, signing keys and payment credentials remain server-held.
NOTORGANIC_ENABLED=false
NOTORGANIC_ISSUER=https://api.notorganic.info
NOTORGANIC_AUTHORIZATION_URL=https://id.notorganic.info/authorize
# Maximum aggregate reserved cost of one hosted asset run, in micro-USD.
# Each run also supplies an explicit budget; this is an operator ceiling, not a price.
NOTORGANIC_MAX_COST_MICROUSD=10000000
