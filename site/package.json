{
  "name": "baste-site",
  "description": "Baste website - Qwik + PandaCSS",
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run `npm run build` and deploy the `dist` folder'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "node server/entry.express",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "prestorybook": "panda codegen && panda cssgen",
    "storybook": "storybook dev --no-open --ci",
    "prebuild-storybook": "panda codegen && panda cssgen",
    "build-storybook": "storybook build",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "build:production": "panda codegen && npm run build.client && npm run build.server"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@pandacss/dev": "^2.1.0",
    "@pandacss/preset-base": "^2.1.0",
    "@pandacss/preset-panda": "^2.1.0",
    "@storybook/builder-vite": "10.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-plugin-qwik": "^1.20.1",
    "prettier": "^3.9.9",
    "storybook": "10.6.1",
    "storybook-framework-qwik": "0.6.1",
    "typescript": "~5.9.3",
    "undici": "^8.11.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "@pandacss/postcss": "^2.1.0",
    "@storybook/addon-docs": "10.6.1",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
